<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/libphonenumber-js@1.11.0/bundle/libphonenumber-js.min.js"></script>
</head>
<body class="bg-gradient-to-br from-purple-600 to-indigo-900 min-h-screen p-8">
<header class="bg-white/90 backdrop-blur-md shadow-lg sticky top-4 z-50 p-4 flex justify-between items-center rounded-2xl mx-auto max-w-4xl mb-8">
  <div class="font-bold text-indigo-900 text-xl">Contact Agent</div>
  <div class="relative">
    <details class="cursor-pointer">
      <summary class="flex items-center gap-3 list-none p-1 pr-3 rounded-full hover:bg-gray-100 transition">
         <img src="https://ui-avatars.com/api/?name={{user.username}}" class="w-10 h-10 rounded-full border-2 border-indigo-100">
         <span class="font-medium text-gray-700">{{user.username}}</span>
      </summary>
      <div class="absolute right-0 mt-2 bg-white rounded-xl shadow-xl p-2 w-32 z-10 border border-gray-100">
        <form action="/users/logout" method="POST" class="mb-0">
          <button type="submit" class="text-red-500 w-full text-left p-2 hover:bg-red-50 rounded">Logout</button>
        </form>
      </div>
    </details>
  </div>
</header>
  <div class="bg-white p-8 rounded-xl shadow-2xl text-gray-900 w-full max-w-sm mx-auto">
    <h1 class="text-2xl font-bold mb-4">{{title}}</h1>
    <form action="{{action}}" method="POST" class="space-y-4">
      <input type="text" name="name" placeholder="Name" value="{{contact.name}}" class="border p-2 w-full rounded" required>
      <input type="email" name="email" placeholder="Email" value="{{contact.email}}" class="border p-2 w-full rounded" required>
      <div class="flex gap-2">
        <input type="text" id="phone" name="phone" placeholder="Phone (+1...)" value="{{contact.phone}}" class="border p-2 w-full rounded" oninput="showFlag(this.value)">
        <div id="flag" class="w-10 flex items-center justify-center"></div>
      </div>
      <script>
        function showFlag(val) {
          const flagDiv = document.getElementById('flag');
          if (!val) {
            flagDiv.innerHTML = '<img src="https://flagcdn.com/w40/un.png" class="w-8 h-6">';
            return;
          }
          
          let countryCode = null;
          
          // Simple mapping for immediate partial code feedback
          if (val.startsWith('+')) {
            const code = val.substring(1).replace(/\D/g, '');
            const callingCodes = {
              '1': 'us', '44': 'gb', '34': 'es', '52': 'mx', '57': 'co', '56': 'cl', '54': 'ar'
            };
            countryCode = callingCodes[code] || null;
          }

          // Try parsing for full number if not found
          if (!countryCode) {
            try {
              const phoneNumber = libphonenumber.parsePhoneNumberFromString(val);
              if (phoneNumber && phoneNumber.country) {
                countryCode = phoneNumber.country.toLowerCase();
              }
            } catch (e) {}
          }

          if (countryCode) {
            flagDiv.innerHTML = `<img src="https://flagcdn.com/w40/${countryCode}.png" class="w-8 h-6">`;
          } else {
            flagDiv.innerHTML = '<img src="https://flagcdn.com/w40/un.png" class="w-8 h-6">';
          }
        }
        // Run on load in case of edit
        document.addEventListener('DOMContentLoaded', () => showFlag(document.getElementById('phone').value));
      </script>
      <button type="submit" class="bg-indigo-600 text-white p-2 w-full rounded font-bold">Save</button>
    </form>
    {{#if error}}<p class="text-red-500 mt-2">{{error}}</p>{{/if}}
    <a href="/contacts" class="block mt-4 text-indigo-600">Back</a>
  </div>
</body>
