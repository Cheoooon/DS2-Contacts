<script src="https://cdn.tailwindcss.com"></script>
<body class="bg-gradient-to-br from-purple-500 to-indigo-700 min-h-screen flex items-center justify-center text-white">
  <div class="bg-white p-8 rounded-lg shadow-lg text-gray-800">
    <h1 class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-indigo-200 to-purple-200 mb-6 drop-shadow-lg text-center">Contact Agent</h1>
    <form action="/users/login" method="POST" class="space-y-4">
      <div class="space-y-2">
        <label for="username" class="sr-only">Username</label>
        <input type="text" id="username" name="username" placeholder="Username" class="border p-3 w-full rounded-xl focus:ring-2 focus:ring-indigo-400 focus:outline-none" required>
      </div>
      <div class="space-y-2">
        <label for="password" class="sr-only">Password</label>
        <input type="password" id="password" name="password" placeholder="Password" class="border p-3 w-full rounded-xl focus:ring-2 focus:ring-indigo-400 focus:outline-none" required>
      </div>
      <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white p-3 w-full rounded-xl font-bold text-lg shadow-lg hover:shadow-indigo-500/50 transition-all duration-300 transform hover:scale-[1.02]">Login</button>
    </form>
    {{#if error}}<p class="text-red-500 mt-2 text-center" role="alert">{{error}}</p>{{/if}}
    <div class="text-center mt-4 text-gray-600">
      Don't have an account? <a href="/users/register" class="text-indigo-600 font-bold hover:underline">Register</a>
    </div>
  </div>
</body>
