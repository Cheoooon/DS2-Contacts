<script src="https://cdn.tailwindcss.com"></script>
<body class="bg-gradient-to-br from-purple-500 to-indigo-700 min-h-screen flex items-center justify-center text-white">
  <div class="bg-white p-8 rounded-lg shadow-lg text-gray-800">
    <h1 class="text-2xl font-bold mb-4">Login</h1>
    <form action="/users/login" method="POST" class="space-y-4">
      <input type="text" name="username" placeholder="Username" class="border p-2 w-full rounded" required>
      <input type="password" name="password" placeholder="Password" class="border p-2 w-full rounded" required>
      <button type="submit" class="bg-indigo-600 text-white p-2 w-full rounded font-bold">Login</button>
    </form>
    {{#if error}}<p class="text-red-500 mt-2">{{error}}</p>{{/if}}
    <a href="/users/register" class="block mt-4 text-indigo-600">Register</a>
  </div>
</body>
