<script src="https://cdn.tailwindcss.com"></script>
<body class="bg-gradient-to-br from-purple-500 to-indigo-700 min-h-screen flex items-center justify-center text-white">
  <div class="bg-white p-8 rounded-lg shadow-lg text-gray-800">
    <h1 class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-indigo-200 to-purple-200 mb-6 drop-shadow-lg text-center">Contact Agent</h1>
    <form action="/users/register" method="POST" class="space-y-4">
      <input type="text" name="username" placeholder="Username" class="border p-3 w-full rounded-xl focus:ring-2 focus:ring-indigo-400 focus:outline-none" required>
      <input type="password" name="password" placeholder="Password" class="border p-3 w-full rounded-xl focus:ring-2 focus:ring-indigo-400 focus:outline-none" required>
      <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white p-3 w-full rounded-xl font-bold text-lg shadow-lg hover:shadow-indigo-500/50 transition-all duration-300 transform hover:scale-[1.02]">Register</button>
    </form>
    {{#if error}}<p class="text-red-500 mt-2">{{error}}</p>{{/if}}
    <a href="/users/login" class="block mt-4 text-indigo-600">Login</a>
  </div>
</body>
