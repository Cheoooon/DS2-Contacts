<script src="https://cdn.tailwindcss.com"></script>
<body class="bg-gradient-to-br from-purple-500 to-indigo-700 min-h-screen flex items-center justify-center text-white">
  <div class="flex flex-col items-center w-full max-w-sm p-4">
    <h1 class="text-4xl font-extrabold text-white mb-6 drop-shadow-lg text-center">Contact Agent</h1>
    <div class="bg-white p-8 rounded-xl shadow-2xl w-full">
      <form action="/users/register" method="POST" class="space-y-4">
        <div class="space-y-2">
          <label for="username" class="sr-only">Username</label>
          <input type="text" id="username" name="username" placeholder="Username" class="border p-3 w-full rounded-xl focus:ring-2 focus:ring-indigo-400 focus:outline-none text-gray-900" required>
        </div>
        <div class="space-y-2">
          <label for="password" class="sr-only">Password</label>
          <input type="password" id="password" name="password" placeholder="Password" class="border p-3 w-full rounded-xl focus:ring-2 focus:ring-indigo-400 focus:outline-none text-gray-900" required>
        </div>
        <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white p-3 w-full rounded-xl font-bold text-lg shadow-lg hover:shadow-indigo-500/50 transition-all duration-300 transform hover:scale-[1.02]">Register</button>
      </form>
      {{#if error}}<p class="text-red-500 mt-4 text-center" role="alert">{{error}}</p>{{/if}}
      <div class="text-center mt-6 text-gray-600">
        Already have an account? <a href="/users/login" class="text-indigo-600 font-bold hover:underline">Login here</a>
      </div>
    </div>
  </div>
</body>
